# Neon PostgreSQL (https://neon.tech)
# "Pooled connection" string do painel do Neon (com ?pgbouncer=true)
DATABASE_URL="postgresql://user:password@ep-xxx.us-east-1.aws.neon.tech/neondb?sslmode=require&pgbouncer=true&connect_timeout=15"

# "Direct connection" string do painel do Neon (sem pgbouncer) - usado nas migrations
DATABASE_URL_UNPOOLED="postgresql://user:password@ep-xxx.us-east-1.aws.neon.tech/neondb?sslmode=require"

# NewsAPI (https://newsapi.org)
NEWS_API_KEY=""

# Resend - Envio de emails (https://resend.com)
RESEND_API_KEY=""
RESEND_FROM_EMAIL="newsletter@lorinvest.com.br"

# Cron Job - gere com: openssl rand -hex 32
CRON_SECRET=""

# App
NEXT_PUBLIC_APP_URL="https://seu-projeto.vercel.app"
