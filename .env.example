# ─── Banco de Dados ───────────────────────────────────────────────────────────
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/gastrocontrol"

# ─── Autenticação ─────────────────────────────────────────────────────────────
# Gerar: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET="mude-isso-para-um-secret-seguro-com-32-chars-ou-mais"

# ─── Webhook PDV ──────────────────────────────────────────────────────────────
PDV_WEBHOOK_SECRET="mude-este-secret-do-pdv-tambem"

# ─── Redis (Opcional) ─────────────────────────────────────────────────────────
REDIS_URL="redis://localhost:6379"

NODE_ENV="development"
