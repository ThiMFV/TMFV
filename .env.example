# Banco de Dados PostgreSQL
DATABASE_URL="postgresql://user:password@localhost:5432/lorinvest_intelligence"

# Anthropic Claude - Enriquecimento IA (https://console.anthropic.com)
# Sem essa chave a ingestao continua funcionando, porem sem resumo/score/insight.
ANTHROPIC_API_KEY=""
ANTHROPIC_MODEL="claude-sonnet-4-6"

# Autenticacao via Vercel Cron / chamadas server-to-server
CRON_SECRET="gere-um-secret-aleatorio-aqui"

# (Opcional) NewsAPI como fonte complementar (https://newsapi.org)
NEWS_API_KEY=""

# (Opcional) SMTP/Resend para alertas inteligentes
RESEND_API_KEY=""
RESEND_FROM_EMAIL="alerts@lorinvest.com.br"

# App
NEXT_PUBLIC_APP_URL="http://localhost:3000"
