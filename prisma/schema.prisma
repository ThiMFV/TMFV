generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Enums ───────────────────────────────────────────────────────────────────

enum BrandType {
  TRADITIONAL_RESTAURANT
  BURGER
  PIZZA
  CAFE
  BAR
  ASIAN
  FAST_FOOD
  DARK_KITCHEN
}

enum UserRole {
  GROUP_ADMIN
  BRAND_ADMIN
  UNIT_MANAGER
  STOCK_KEEPER
  BUYER
  FINANCIAL
}

enum UOM {
  KG
  G
  L
  ML
  UN
  CX
  PCT
  SC
  BD
}

enum MovementType {
  ENTRY
  TRANSFER_IN
  TRANSFER_OUT
  CONSUMPTION
  LOSS
  WASTE
  ADJUSTMENT
  INVENTORY_ADJUSTMENT
}

enum LotStatus {
  ACTIVE
  EXPIRED
  DEPLETED
  QUARANTINE
}

enum LossType {
  EXPIRY
  BREAKAGE
  EXCESS_PRODUCTION
  OPERATIONAL_ERROR
  THEFT
  SANITARY_DISCARD
}

enum PRStatus {
  DRAFT
  PENDING_APPROVAL
  APPROVED
  REJECTED
  CONVERTED
}

enum POStatus {
  DRAFT
  SENT
  PARTIAL_RECEIVED
  RECEIVED
  CANCELLED
}

enum CountType {
  DAILY
  WEEKLY
  MONTHLY
  ANNUAL
}

enum CountStatus {
  DRAFT
  IN_PROGRESS
  FINISHED
  APPROVED
}

enum PDVProvider {
  LINX
  COLIBRI
  NCR
  ORACLE_SIMPHONY
  TOAST
  MICROS
  CUSTOM
}

enum AlertType {
  LOW_STOCK
  EXPIRING_PRODUCT
  INVENTORY_DIVERGENCE
  HIGH_LOSSES
  SUPPLIER_DELAYED
  RUPTURE
}

enum AlertSeverity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

// ─── Models ──────────────────────────────────────────────────────────────────

model Group {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  logo      String?
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  brands    Brand[]
  users     User[]
  suppliers Supplier[]
  products  Product[]
  categories Category[]
}

model Brand {
  id        String    @id @default(cuid())
  groupId   String
  group     Group     @relation(fields: [groupId], references: [id])
  name      String
  slug      String
  type      BrandType
  logo      String?
  active    Boolean   @default(true)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  units     Unit[]
  users     User[]
  products  Product[]
  categories Category[]

  @@unique([groupId, slug])
}

model Unit {
  id        String   @id @default(cuid())
  brandId   String
  brand     Brand    @relation(fields: [brandId], references: [id])
  name      String
  code      String
  address   String?
  city      String?
  state     String?
  country   String   @default("BR")
  timezone  String   @default("America/Sao_Paulo")
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users              User[]
  categories         Category[]
  productCosts       ProductCost[]
  inventoryLots      InventoryLot[]
  stockMovements     StockMovement[]
  technicalSheets    TechnicalSheet[]
  purchaseRequests   PurchaseRequest[]
  purchaseOrders     PurchaseOrder[]
  goodsReceipts      GoodsReceipt[]
  lossRecords        LossRecord[]
  inventoryCounts    InventoryCount[]
  pdvIntegrations    PDVIntegration[]
  saleEvents         SaleEvent[]
  alerts             Alert[]

  @@unique([brandId, code])
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String
  role         UserRole
  groupId      String?
  group        Group?   @relation(fields: [groupId], references: [id])
  brandId      String?
  brand        Brand?   @relation(fields: [brandId], references: [id])
  unitId       String?
  unit         Unit?    @relation(fields: [unitId], references: [id])
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  sessions           UserSession[]
  stockMovements     StockMovement[]
  purchaseRequests   PurchaseRequest[] @relation("RequestedBy")
  approvedRequests   PurchaseRequest[] @relation("ApprovedBy")
  purchaseOrders     PurchaseOrder[]
  goodsReceipts      GoodsReceipt[]
  lossRecords        LossRecord[]
  inventoryCounts    InventoryCount[]
}

model UserSession {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
}

model Category {
  id        String     @id @default(cuid())
  name      String
  parentId  String?
  parent    Category?  @relation("CategoryChildren", fields: [parentId], references: [id])
  children  Category[] @relation("CategoryChildren")
  unitId    String?
  unit      Unit?      @relation(fields: [unitId], references: [id])
  brandId   String?
  brand     Brand?     @relation(fields: [brandId], references: [id])
  groupId   String?
  group     Group?     @relation(fields: [groupId], references: [id])
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  products  Product[]
}

model Supplier {
  id        String   @id @default(cuid())
  name      String
  cnpj      String?
  email     String?
  phone     String?
  address   String?
  groupId   String
  group     Group    @relation(fields: [groupId], references: [id])
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  inventoryLots        InventoryLot[]
  purchaseRequestItems PurchaseRequestItem[]
  purchaseOrders       PurchaseOrder[]
}

model Product {
  id             String   @id @default(cuid())
  sku            String
  internalCode   String?
  name           String
  description    String?
  categoryId     String
  category       Category @relation(fields: [categoryId], references: [id])
  unitOfMeasure  UOM
  groupId        String
  group          Group    @relation(fields: [groupId], references: [id])
  brandId        String?
  brand          Brand?   @relation(fields: [brandId], references: [id])
  weight         Float?
  volume         Float?
  minStock       Float    @default(0)
  idealStock     Float    @default(0)
  shelfLifeDays  Int?
  active         Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  costs                    ProductCost[]
  inventoryLots            InventoryLot[]
  stockMovements           StockMovement[]
  technicalSheetIngredients TechnicalSheetIngredient[]
  purchaseRequestItems     PurchaseRequestItem[]
  purchaseOrderItems       PurchaseOrderItem[]
  goodsReceiptItems        GoodsReceiptItem[]
  lossRecords              LossRecord[]
  inventoryCountItems      InventoryCountItem[]
  alerts                   Alert[]

  @@unique([groupId, sku])
}

model ProductCost {
  id          String   @id @default(cuid())
  productId   String
  product     Product  @relation(fields: [productId], references: [id])
  unitId      String
  unit        Unit     @relation(fields: [unitId], references: [id])
  averageCost Float    @default(0)
  lastCost    Float    @default(0)
  updatedAt   DateTime @updatedAt

  @@unique([productId, unitId])
}

model InventoryLot {
  id                String    @id @default(cuid())
  productId         String
  product           Product   @relation(fields: [productId], references: [id])
  unitId            String
  unit              Unit      @relation(fields: [unitId], references: [id])
  supplierId        String?
  supplier          Supplier? @relation(fields: [supplierId], references: [id])
  lotNumber         String
  manufacturingDate DateTime?
  expiryDate        DateTime?
  invoiceNumber     String?
  quantity          Float
  remainingQuantity Float
  unitCost          Float
  status            LotStatus @default(ACTIVE)
  createdAt         DateTime  @default(now())

  stockMovements    StockMovement[]
  goodsReceiptItems GoodsReceiptItem[]
  lossRecords       LossRecord[]
  inventoryCountItems InventoryCountItem[]
}

model StockMovement {
  id            String       @id @default(cuid())
  productId     String
  product       Product      @relation(fields: [productId], references: [id])
  unitId        String
  unit          Unit         @relation(fields: [unitId], references: [id])
  lotId         String?
  lot           InventoryLot? @relation(fields: [lotId], references: [id])
  userId        String
  user          User         @relation(fields: [userId], references: [id])
  type          MovementType
  quantity      Float
  unitCost      Float
  totalCost     Float
  reason        String?
  notes         String?
  referenceId   String?
  referenceType String?
  createdAt     DateTime     @default(now())
}

model TechnicalSheet {
  id              String   @id @default(cuid())
  name            String
  description     String?
  unitId          String
  unit            Unit     @relation(fields: [unitId], references: [id])
  yield           Float
  yieldUnit       UOM
  preparationTime Int?
  cost            Float    @default(0)
  active          Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  ingredients TechnicalSheetIngredient[]
}

model TechnicalSheetIngredient {
  id               String         @id @default(cuid())
  technicalSheetId String
  technicalSheet   TechnicalSheet @relation(fields: [technicalSheetId], references: [id])
  productId        String
  product          Product        @relation(fields: [productId], references: [id])
  quantity         Float
  unitOfMeasure    UOM
  wasteFactor      Float          @default(0)
  netQuantity      Float
}

model PurchaseRequest {
  id           String   @id @default(cuid())
  unitId       String
  unit         Unit     @relation(fields: [unitId], references: [id])
  requestedById String
  requestedBy  User     @relation("RequestedBy", fields: [requestedById], references: [id])
  approvedById  String?
  approvedBy   User?    @relation("ApprovedBy", fields: [approvedById], references: [id])
  status       PRStatus @default(DRAFT)
  notes        String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  items          PurchaseRequestItem[]
  purchaseOrders PurchaseOrder[]
}

model PurchaseRequestItem {
  id                String          @id @default(cuid())
  purchaseRequestId String
  purchaseRequest   PurchaseRequest @relation(fields: [purchaseRequestId], references: [id])
  productId         String
  product           Product         @relation(fields: [productId], references: [id])
  quantity          Float
  unitOfMeasure     UOM
  estimatedCost     Float?
  supplierId        String?
  supplier          Supplier?       @relation(fields: [supplierId], references: [id])
}

model PurchaseOrder {
  id                String           @id @default(cuid())
  purchaseRequestId String?
  purchaseRequest   PurchaseRequest? @relation(fields: [purchaseRequestId], references: [id])
  unitId            String
  unit              Unit             @relation(fields: [unitId], references: [id])
  supplierId        String
  supplier          Supplier         @relation(fields: [supplierId], references: [id])
  createdById       String
  createdBy         User             @relation(fields: [createdById], references: [id])
  status            POStatus         @default(DRAFT)
  totalAmount       Float
  expectedDelivery  DateTime?
  notes             String?
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt

  items         PurchaseOrderItem[]
  goodsReceipts GoodsReceipt[]
}

model PurchaseOrderItem {
  id              String        @id @default(cuid())
  purchaseOrderId String
  purchaseOrder   PurchaseOrder @relation(fields: [purchaseOrderId], references: [id])
  productId       String
  product         Product       @relation(fields: [productId], references: [id])
  quantity        Float
  unitCost        Float
  totalCost       Float
}

model GoodsReceipt {
  id              String        @id @default(cuid())
  purchaseOrderId String
  purchaseOrder   PurchaseOrder @relation(fields: [purchaseOrderId], references: [id])
  unitId          String
  unit            Unit          @relation(fields: [unitId], references: [id])
  receivedById    String
  receivedBy      User          @relation(fields: [receivedById], references: [id])
  invoiceNumber   String
  receiptDate     DateTime
  notes           String?
  createdAt       DateTime      @default(now())

  items GoodsReceiptItem[]
}

model GoodsReceiptItem {
  id               String       @id @default(cuid())
  goodsReceiptId   String
  goodsReceipt     GoodsReceipt @relation(fields: [goodsReceiptId], references: [id])
  productId        String
  product          Product      @relation(fields: [productId], references: [id])
  lotId            String
  lot              InventoryLot @relation(fields: [lotId], references: [id])
  quantityOrdered  Float
  quantityReceived Float
  unitCost         Float
}

model LossRecord {
  id         String    @id @default(cuid())
  productId  String
  product    Product   @relation(fields: [productId], references: [id])
  unitId     String
  unit       Unit      @relation(fields: [unitId], references: [id])
  lotId      String?
  lot        InventoryLot? @relation(fields: [lotId], references: [id])
  userId     String
  user       User      @relation(fields: [userId], references: [id])
  type       LossType
  quantity   Float
  unitCost   Float
  totalCost  Float
  reason     String
  notes      String?
  reportedAt DateTime  @default(now())
}

model InventoryCount {
  id          String      @id @default(cuid())
  unitId      String
  unit        Unit        @relation(fields: [unitId], references: [id])
  type        CountType
  status      CountStatus @default(DRAFT)
  createdById String
  createdBy   User        @relation(fields: [createdById], references: [id])
  startedAt   DateTime    @default(now())
  finishedAt  DateTime?
  notes       String?

  items InventoryCountItem[]
}

model InventoryCountItem {
  id               String         @id @default(cuid())
  inventoryCountId String
  inventoryCount   InventoryCount @relation(fields: [inventoryCountId], references: [id])
  productId        String
  product          Product        @relation(fields: [productId], references: [id])
  lotId            String?
  lot              InventoryLot?  @relation(fields: [lotId], references: [id])
  systemQuantity   Float
  countedQuantity  Float
  divergence       Float
  unitCost         Float
  divergenceValue  Float
}

model PDVIntegration {
  id        String      @id @default(cuid())
  unitId    String
  unit      Unit        @relation(fields: [unitId], references: [id])
  provider  PDVProvider
  config    Json
  active    Boolean     @default(true)
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt
}

model SaleEvent {
  id          String   @id @default(cuid())
  unitId      String
  unit        Unit     @relation(fields: [unitId], references: [id])
  externalId  String
  saleDate    DateTime
  totalAmount Float
  items       Json
  processedAt DateTime?
  createdAt   DateTime @default(now())

  @@unique([unitId, externalId])
}

model Alert {
  id        String        @id @default(cuid())
  type      AlertType
  unitId    String
  unit      Unit          @relation(fields: [unitId], references: [id])
  productId String?
  product   Product?      @relation(fields: [productId], references: [id])
  message   String
  severity  AlertSeverity
  read      Boolean       @default(false)
  createdAt DateTime      @default(now())
}
